<div class="container mt-4 w-50">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><%= @task.title %></h1>
    <%= link_to "Edit Task", edit_task_path(@task), class: "btn btn-outline-primary" %>
  </div>
  <div class="mb-4">
    <p class="mb-4 alert alert-info"><%= @task.details %></p>
    <div class="mb-4">
      <input type="checkbox" <%= "checked" if @task.completed %> disabled>
      <span>This task is <%= @task.completed ? "" : "not " %>completed</span>
    </div>
  </div>
  <p class="mb-4"><%= link_to "Back to list", tasks_path %></p>
</div>